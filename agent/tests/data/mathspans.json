{
  "comment": [
    "Shared math-span and Unicode-math fixture. The Python side is",
    "tested by agent/tests/test_speech_math.py; the C++ side by",
    "theme/mathspantest.cpp. Both read THIS file, so the daemon's",
    "spoken spans and the renderer's images cannot drift apart."
  ],
  "spans": [
    {
      "input": "Euler wrote $e^{i\\pi} + 1 = 0$ in a letter.",
      "expected": [
        {
          "start": 12,
          "end": 30,
          "kind": "inline_dollar",
          "body": "e^{i\\pi} + 1 = 0"
        }
      ]
    },
    {
      "input": "It costs $5 and $10, so no math here.",
      "expected": []
    },
    {
      "input": "The identity $$x^2 + y^2 = z^2$$ is Pythagoras.",
      "expected": [
        {
          "start": 13,
          "end": 32,
          "kind": "display_dollar",
          "body": "x^2 + y^2 = z^2"
        }
      ]
    },
    {
      "input": "Behold \\[a + b\\] inline brackets.",
      "expected": [
        {
          "start": 7,
          "end": 16,
          "kind": "display_bracket",
          "body": "a + b"
        }
      ]
    },
    {
      "input": "Behold \\(a + b\\) parenthesized.",
      "expected": [
        {
          "start": 7,
          "end": 16,
          "kind": "inline_paren",
          "body": "a + b"
        }
      ]
    },
    {
      "input": "A single letter $x$ counts as math.",
      "expected": [
        {
          "start": 16,
          "end": 19,
          "kind": "inline_dollar",
          "body": "x"
        }
      ]
    },
    {
      "input": "Spaced $ x $ dollars are currency, not math.",
      "expected": []
    },
    {
      "input": "Mixed $a$ and $$b$$ kinds.",
      "expected": [
        {
          "start": 6,
          "end": 9,
          "kind": "inline_dollar",
          "body": "a"
        },
        {
          "start": 14,
          "end": 19,
          "kind": "display_dollar",
          "body": "b"
        }
      ]
    },
    {
      "input": "Use $$a$$ then $b$ in one line.",
      "expected": [
        {
          "start": 4,
          "end": 9,
          "kind": "display_dollar",
          "body": "a"
        },
        {
          "start": 15,
          "end": 18,
          "kind": "inline_dollar",
          "body": "b"
        }
      ]
    },
    {
      "input": "Unicode prose: for α ≤ 3 the series ∑ x converges — no spans.",
      "expected": []
    },
    {
      "input": "before\n$$\n\\int_0^1 x\\,dx\n$$\nafter",
      "expected": [
        {
          "start": 7,
          "end": 27,
          "kind": "display_dollar",
          "body": "\n\\int_0^1 x\\,dx\n"
        }
      ]
    },
    {
      "input": "$5, $10 and $15 are prices.",
      "expected": []
    },
    {
      "input": "A newline inside $a\nb$ hugs nothing and \\(a\nb\\) cannot span either.",
      "expected": []
    },
    {
      "input": "Two on one line: $a + b$ and $c + d$.",
      "expected": [
        {
          "start": 17,
          "end": 24,
          "kind": "inline_dollar",
          "body": "a + b"
        },
        {
          "start": 29,
          "end": 36,
          "kind": "inline_dollar",
          "body": "c + d"
        }
      ]
    }
  ],
