<component type="addon">
  <id>org.phoenixdna.agent</id>
  <metadata_license>FSFAP</metadata_license>
  <project_license>BSD-2-Clause</project_license>
  <name>Phoenix DNA</name>
  <summary>Voice-first AI agent for the Plasma panel</summary>
  <description>
    <p>
      Phoenix DNA is a desktop-native AI agent for KDE Plasma. It lives in the
      panel, takes dictated or typed prompts, runs them through an LLM-driven
      agent loop, and shows the answer in a native window.
    </p>
    <p>
      The agent works as the desktop user, can attach files and screenshots to
      a prompt, asks for administrator rights through KDE's password dialog
      when a command needs them, and can read its answers aloud.
    </p>
  </description>
  <extends>org.kde.plasmashell</extends>
  <url type="homepage">https://gitlab.com/junzi/phoenix-dna</url>
  <developer id="org.phoenixdna">
    <name>Phoenix DNA contributors</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@PROJECT_VERSION@" date="2026-11-04"/>
  </releases>
</component>
