#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Phoenix DNA contributors
# SPDX-License-Identifier: BSD-2-Clause

%:
	dh $@ --buildsystem=cmake --builddirectory=obj-$(DEB_HOST_GNU_TYPE)

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DBUILD_TESTING=ON \
		-DPHOENIX_BUILD_DEVTOOLS=OFF \
		-DPHOENIX_UPDATE_CACHES=OFF \
		-DPHOENIX_AGENT_PYTHON=/usr/bin/python3

# The CPU meter test samples real processes and is timing-sensitive; run the
# suite serially instead of letting dh_auto_test fan it out over -jN.
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
override_dh_auto_test:
	cd obj-$(DEB_HOST_GNU_TYPE) && \
		QT_QPA_PLATFORM=offscreen ctest --output-on-failure
endif
